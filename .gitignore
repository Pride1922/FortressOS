# FortressOS .gitignore

# Build outputs and intermediate objects
build/
bin/
*.o
*.d
*.elf
*.bin
# Checked-in compositor font atlas; ordinary builds need no font rasterizer.
!user/compositor/assets/ui-alpha.bin
!user/compositor/assets/ui-advances.bin
*.iso
*.img

# Bootloader and UEFI firmware dependencies
limine/
limine-*.tar.gz
limine-*.tar.xz
ovmf/
OVMF*.fd

# Editor and OS artifacts
.vscode/
.VSCodeCounter/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
# Python test-runner caches
__pycache__/
*.pyc

# IDE attachments
.codex-remote-attachments/
data256k.bin.sha256
