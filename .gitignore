# FortressOS .gitignore

# Build outputs and intermediate objects
build/
bin/
# Rust binaries of the desktop crate are sources, not build output.
!user/compositor/src/bin/
*.o
*.d
*.elf
*.bin
# Checked-in font atlas; ordinary builds need no font rasterizer.
!user/libui/assets/ui-alpha.bin
!user/libui/assets/ui-advances.bin
!user/libui/assets/ui-title-alpha.bin
!user/libui/assets/ui-title-advances.bin
!user/libui/assets/ui-caption-alpha.bin
!user/libui/assets/ui-caption-advances.bin
*.iso
*.img
target/
**/target/

# Bootloader and UEFI firmware dependencies
limine/
limine-*.tar.gz
limine-*.tar.xz
ovmf/
OVMF*.fd

# Editor and OS artifacts
.vscode/
.VSCodeCounter/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
# Python test-runner caches
__pycache__/
*.pyc

# IDE attachments
.codex-remote-attachments/
data256k.bin.sha256
